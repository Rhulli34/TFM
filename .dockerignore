# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Python artefacts ──────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── Secrets (never bake credentials into the image) ───────────────────────────
.env
*.env.local

# ── Dev-only directories ──────────────────────────────────────────────────────
notebooks/
tests/
scripts/
docs/

# ── Data ─────────────────────────────────────────────────────────────────────
# Exclude everything in data/ EXCEPT the SQLite DB snapshot, which is baked into
# the image for self-contained deployment (e.g., HF Spaces has no host volumes).
# docker-compose.yml can mount a fresher local copy on top for dev.
data/
!data/processed/radar.db

# ── Reports (generated at runtime; mount reports/briefings/ if persistence is needed)
reports/

# ── Models (downloaded from HF Hub at build time — not copied from host) ──────
models/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.DS_Store
.claude/
CLAUDE.md
CLAUDE.local.md
